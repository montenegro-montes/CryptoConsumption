<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/activity_batch_Symm"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingBottom="@dimen/activity_vertical_margin"
    android:paddingLeft="@dimen/activity_horizontal_margin"
    android:paddingRight="@dimen/activity_horizontal_margin"
    android:paddingTop="@dimen/activity_vertical_margin">

    <Spinner
        android:layout_width="160dp"
        android:layout_height="wrap_content"
        android:id="@+id/spinnerOperationSym"
        android:layout_below="@+id/spinnerAlgSym"
        android:layout_alignParentLeft="true"
        android:layout_marginTop="11dp" />

    <Spinner
        android:layout_width="160dp"
        android:layout_height="wrap_content"
        android:id="@+id/spinnerAlgSym"
        android:layout_alignParentTop="true"
        android:layout_alignParentLeft="true"
 />

    <TextView
        android:text="Progress..."
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/textViewProgressSym"
        android:layout_marginTop="90dp"
        android:textSize="18sp"
        android:layout_below="@+id/spinnerOperationSym"
        android:layout_alignParentLeft="true"
        />

    <Button
        android:text="Go!"
        android:layout_height="wrap_content"
        android:id="@+id/buttonSymmetricMode"
        android:layout_width="120dp"
        android:onClick="OnClick"
        android:layout_alignBottom="@+id/textViewProgressSym"
        android:layout_alignParentRight="true" />

    <Spinner
        android:id="@+id/spinnerSize"
        android:layout_width="130dp"
        android:layout_height="wrap_content"
        android:layout_alignBaseline="@+id/spinnerOperationSym"
        android:layout_alignBottom="@+id/spinnerOperationSym"
        android:layout_alignParentRight="true" />

</RelativeLayout>
