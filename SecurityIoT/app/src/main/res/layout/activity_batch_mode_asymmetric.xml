<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/activity_batch_mode2"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingBottom="@dimen/activity_vertical_margin"
    android:paddingLeft="@dimen/activity_horizontal_margin"
    android:paddingRight="@dimen/activity_horizontal_margin"
    android:paddingTop="@dimen/activity_vertical_margin">

    <Spinner
        android:layout_width="160dp"
        android:layout_height="wrap_content"
        android:id="@+id/spinnerOperationAsym"
        android:layout_below="@+id/spinnerAlgASym"
        android:layout_alignParentLeft="true"
        android:layout_marginTop="11dp" />

    <Spinner
        android:layout_width="160dp"
        android:layout_height="wrap_content"
        android:id="@+id/spinnerAlgASym"
        android:layout_alignParentTop="true"
        android:layout_alignParentLeft="true"
         />

    <TextView
        android:text="@string/progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/textViewProgressAsym"
        android:layout_marginTop="74dp"
        android:textSize="18sp"
        android:layout_below="@+id/spinnerOperationAsym"
        android:layout_alignParentLeft="true"
         />

    <Button
        android:text="@string/go"
        android:layout_height="wrap_content"
        android:id="@+id/buttonAsymmetricMode"
        android:layout_width="120dp"
        android:onClick="OnClickAsymm"
        android:layout_alignBottom="@+id/textViewProgressAsym"
        android:layout_alignParentRight="true" />

    <Spinner
        android:id="@+id/spinnerSize"
        android:layout_width="130dp"
        android:layout_height="wrap_content"
        android:layout_alignBaseline="@+id/spinnerOperationAsym"
        android:layout_alignBottom="@+id/spinnerOperationAsym"
        android:layout_alignParentRight="true" />

</RelativeLayout>
