<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/activity_batch_mode_hash_mac"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingBottom="@dimen/activity_vertical_margin"
    android:paddingLeft="@dimen/activity_horizontal_margin"
    android:paddingRight="@dimen/activity_horizontal_margin"
    android:paddingTop="@dimen/activity_vertical_margin">

    <Spinner
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/spinnerProviderHashMac"
        android:layout_alignParentTop="true"
        android:layout_alignParentRight="true"
         />

    <TextView
        android:text="Progress..."
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/textViewProgressHashMap"
        android:layout_weight="4.30"
        android:layout_marginTop="21dp"
        android:textSize="18sp"
        android:layout_below="@+id/buttonMacHash"
        android:layout_alignParentLeft="true"
        />

    <Button
        android:text="Go!"
        android:layout_height="wrap_content"
        android:id="@+id/buttonMacHash"
        android:layout_width="120dp"
        android:onClick="onClick"
        android:layout_marginRight="20dp"
        android:layout_below="@+id/spinnerAlgMode"
        android:layout_alignParentRight="true"
        android:layout_marginTop="38dp" />

    <Spinner
        android:layout_height="wrap_content"
        android:id="@+id/spinnerAlgMode"
        android:layout_width="160dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentLeft="true" />

</RelativeLayout>
