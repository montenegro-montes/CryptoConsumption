<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/activity_main"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingBottom="@dimen/activity_vertical_margin"
    android:paddingLeft="@dimen/activity_horizontal_margin"
    android:paddingRight="@dimen/activity_horizontal_margin"
    android:paddingTop="@dimen/activity_vertical_margin"
    android:background="@drawable/fondo">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/consumption_cryptographic"
        android:textSize="18sp"
        android:textStyle="normal|bold"
        android:textColor="@color/colorAccent"
        android:layout_marginTop="11dp"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:id="@+id/textView3" />



    <Button
        android:text="@string/clear_data"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp"
        android:onClick="onClick"
        android:id="@+id/buttonIDClearValues"
        android:layout_below="@+id/textView3"
        android:layout_centerHorizontal="true" />

 <Button
     android:text="@string/batchmode_symmetric"
     android:layout_width="160dp"
     android:layout_height="wrap_content"
     android:id="@+id/buttonSymBatchMode"
     android:onClick="onClick"
     android:layout_below="@+id/buttonIDClearValues"
     android:layout_marginTop="25dp"
     android:layout_centerVertical="true"
     android:layout_centerHorizontal="true" />


    <Button
         android:text="@string/batchmode_asymmetric"
         android:layout_width="160dp"
         android:layout_height="wrap_content"
         android:id="@+id/buttonAsymBatchMode"
         android:onClick="onClick"
        android:layout_centerVertical="true"
        android:layout_centerHorizontal="true"
        android:layout_below="@+id/buttonSymBatchMode" />

    <Button
           android:text="@string/hash"
           android:layout_width="160dp"
           android:layout_height="wrap_content"
           android:id="@+id/buttonHash"
          android:onClick="onClick"
            android:layout_centerVertical="true"
            android:layout_centerHorizontal="true"
            android:layout_below="@+id/buttonAsymBatchMode" />

    <ScrollView
        android:id="@+id/SCROLLER_ID"
        android:layout_width="fill_parent"
        android:layout_centerVertical="true"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="10dp"
        android:layout_below="@+id/buttonHash"
        android:scrollbars="vertical"
        android:fillViewport="true"
        android:layout_height="100dp">
        <TextView
            android:text=""
            android:id="@+id/textViewInfoPanel"
            android:layout_height="60dp"
            android:layout_width="300dp"/>
      </ScrollView>

    </RelativeLayout>
